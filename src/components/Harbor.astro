---
const gullPositions = [
	{ top: '12%', delay: '-4s', duration: '46s' },
	{ top: '19%', delay: '-21s', duration: '58s' },
	{ top: '27%', delay: '-33s', duration: '52s' },
];
---

<div class="lighthouse">
	<span class="lighthouse-beam"></span>
	<svg
		viewBox="0 0 12 40"
		shape-rendering="crispEdges"
		aria-hidden="true"
		focusable="false"
	>
		<rect class="lh-base" x="2" y="34" width="8" height="6"></rect>
		<rect class="lh-rust" x="3" y="10" width="6" height="24"></rect>
		<rect class="lh-white" x="3" y="16" width="6" height="4"></rect>
		<rect class="lh-white" x="3" y="24" width="6" height="4"></rect>
		<rect class="lh-base" x="2" y="8" width="8" height="2"></rect>
		<rect class="lh-lamp" x="4" y="3" width="4" height="5"></rect>
		<rect class="lh-rust" x="3" y="2" width="6" height="1"></rect>
		<rect class="lh-rust" x="5" y="0" width="2" height="2"></rect>
	</svg>
</div>

<div class="ship">
	<svg
		viewBox="0 0 64 24"
		shape-rendering="crispEdges"
		aria-hidden="true"
		focusable="false"
	>
		<rect class="sh-hull" x="0" y="16" width="64" height="6"></rect>
		<rect class="sh-hull" x="60" y="14" width="4" height="2"></rect>
		<rect class="sh-rust" x="0" y="20" width="64" height="2"></rect>
		<rect class="sh-hull" x="6" y="8" width="14" height="8"></rect>
		<rect class="sh-hull" x="9" y="4" width="8" height="4"></rect>
		<rect class="sh-rust" x="13" y="0" width="3" height="4"></rect>
		<rect class="sh-rust" x="26" y="10" width="8" height="6"></rect>
		<rect class="sh-steel" x="34" y="10" width="8" height="6"></rect>
		<rect class="sh-amber" x="42" y="10" width="8" height="6"></rect>
		<rect class="sh-steel" x="30" y="4" width="8" height="6"></rect>
		<rect class="sh-rust" x="38" y="4" width="8" height="6"></rect>
		<rect class="sh-lit" x="11" y="10" width="2" height="2"></rect>
		<rect class="sh-lit" x="15" y="10" width="2" height="2"></rect>
		<rect class="sh-lit" x="11" y="5" width="2" height="1"></rect>
	</svg>
</div>

{
	gullPositions.map((g) => (
		<div class="gull" style={`top:${g.top};animation-delay:${g.delay};animation-duration:${g.duration}`}>
			<svg
				viewBox="0 0 14 6"
				shape-rendering="crispEdges"
				aria-hidden="true"
				focusable="false"
			>
				<g class="wing-up">
					<rect x="0" y="0" width="2" height="2"></rect>
					<rect x="2" y="2" width="3" height="2"></rect>
					<rect x="5" y="3" width="4" height="2"></rect>
					<rect x="9" y="2" width="3" height="2"></rect>
					<rect x="12" y="0" width="2" height="2"></rect>
				</g>
				<g class="wing-down">
					<rect x="0" y="4" width="2" height="2"></rect>
					<rect x="2" y="3" width="3" height="2"></rect>
					<rect x="5" y="2" width="4" height="2"></rect>
					<rect x="9" y="3" width="3" height="2"></rect>
					<rect x="12" y="4" width="2" height="2"></rect>
				</g>
			</svg>
		</div>
	))
}

<div class="water"></div>
