---
import '../styles/arena.css';
import Skyline from '../components/Skyline.astro';
import Zuraw from '../components/Zuraw.astro';
import Monument from '../components/Monument.astro';
import Harbor from '../components/Harbor.astro';
import Crest from '../components/Crest.astro';
---

<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Press+Start+2P&display=swap"
		/>
		<title>Mayhem w Stoczni</title>
	</head>
	<body>
		<div class="sky" aria-hidden="true">
			<div class="stars"></div>
			<div class="sky-layer layer-far"><Skyline layer="far" /></div>
			<div class="sky-layer layer-near"><Skyline layer="near" /></div>
			<div class="sky-landmarks">
				<Monument />
				<Zuraw />
			</div>
			<Harbor />
		</div>

		<main>
			<div class="gate" aria-hidden="true">
				<span class="gate-pylon"></span>
				<span class="gate-sign">STOCZNIA GDAŃSKA<small>BRAMA NR 2</small></span>
				<span class="gate-pylon"></span>
			</div>

			<header class="title-wrap">
				<h1><Crest />Mayhem w Stoczni</h1>
				<p class="subtitle">Arena pojedynków na kontrybucje z GitHuba</p>
				<p class="place">Nabrzeże Motławy, noc</p>
			</header>

			<form id="duel-form" class="console" novalidate>
				<div class="field">
					<label for="player1">Gracz 1</label>
					<input id="player1" name="player1" autocomplete="off" required />
				</div>
				<div class="field">
					<label for="player2">Gracz 2</label>
					<input id="player2" name="player2" autocomplete="off" required />
				</div>
				<button type="submit">Walcz!</button>
			</form>

			<div class="stage">
				<div class="gantry-beam" aria-hidden="true">
					<span class="trolley"></span>
					<span class="beacon"></span>
				</div>
				<div class="gantry-leg left" aria-hidden="true"></div>
				<div class="gantry-leg right" aria-hidden="true"></div>
				<section id="results" aria-live="polite">
					<p class="status">Podaj dwóch graczy i naciśnij „Walcz!”</p>
				</section>
				<div class="quay" aria-hidden="true"></div>
			</div>
		</main>

		<script>
			import type { ContribsResponse } from '../lib/contributions';
			import { longestStreak } from '../lib/streak';

			const form = document.querySelector<HTMLFormElement>('#duel-form')!;
			const results = document.querySelector<HTMLElement>('#results')!;
			const button = form.querySelector('button')!;

			function el(tag: string, text: string, className?: string) {
				const node = document.createElement(tag);
				node.textContent = text;
				if (className) node.className = className;
				return node;
			}

			function box(className: string, ...children: Node[]) {
				const node = el('div', '', className);
				node.append(...children);
				return node;
			}

			function showMessage(text: string, isError = false) {
				results.replaceChildren(el('p', text, isError ? 'error' : 'status'));
			}

			function showLoading() {
				const lift = box('loader-lift', el('span', '', 'rope'), el('span', '', 'hook'), el('span', '', 'loader-crate'));
				const loader = box('loader', box('loader-bay', lift), el('span', 'Ładowanie…'));
				loader.setAttribute('role', 'status');
				results.replaceChildren(loader);
			}

			function dayLabel(firstDay: string, weekday: number, count: number) {
				const date = new Date(`${firstDay}T00:00:00Z`);
				date.setUTCDate(date.getUTCDate() + weekday);
				return `${date.toISOString().slice(0, 10)}: ${count}`;
			}

			function renderGraph(data: ContribsResponse, name: string) {
				const graph = el('div', '', 'graph');
				graph.setAttribute('role', 'img');
				graph.setAttribute(
					'aria-label',
					`Kontrybucje użytkownika ${name}: ${data.total_contributions}, od ${data.from} do ${data.to}`,
				);
				data.weeks.forEach((week, col) => {
					for (const day of week.contribution_days) {
						const cell = el('span', '', 'day');
						cell.style.gridColumn = String(col + 1);
						cell.style.gridRow = String(day.weekday + 1);
						cell.dataset.level = String(Math.min(4, Math.max(0, day.level)));
						cell.title = dayLabel(week.first_day, day.weekday, day.count);
						graph.append(cell);
					}
				});
				return box('graph-scroll', graph);
			}

			function renderVsRig() {
				const swing = box('vs-swing', el('span', '', 'rope'), el('span', '', 'hook'), el('div', 'VS', 'vs-box'));
				const carriage = box('vs-carriage', el('span', '', 'trolley'), swing);
				const rig = box('vs-rig', box('vs-girder'), box('vs-track', carriage));
				rig.setAttribute('aria-hidden', 'true');
				return rig;
			}

			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const root = document.documentElement;
				addEventListener(
					'pointermove',
					(e) => root.style.setProperty('--px', String((e.clientX / innerWidth - 0.5) * 2)),
					{ passive: true },
				);
				let ticking = false;
				addEventListener(
					'scroll',
					() => {
						if (ticking) return;
						ticking = true;
						requestAnimationFrame(() => {
							root.style.setProperty('--sy', String(scrollY));
							ticking = false;
						});
					},
					{ passive: true },
				);
			}

			async function load(name: string): Promise<ContribsResponse> {
				let res: Response;
				try {
					res = await fetch(`/api/contributions/${encodeURIComponent(name)}`);
				} catch {
					throw new Error('Nie udało się pobrać danych. Spróbuj ponownie.');
				}
				if (!res.ok) {
					const body = await res.json().catch(() => null);
					throw new Error(`${name}: ${body?.error ?? 'Nie udało się pobrać danych.'}`);
				}
				return res.json();
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const names = [
					(form.elements.namedItem('player1') as HTMLInputElement).value.trim(),
					(form.elements.namedItem('player2') as HTMLInputElement).value.trim(),
				];

				if (!names[0] || !names[1]) {
					showMessage('Podaj nazwy obu graczy.', true);
					return;
				}
				if (names[0].toLowerCase() === names[1].toLowerCase()) {
					showMessage('Wybierz dwóch różnych graczy.', true);
					return;
				}

				button.disabled = true;
				showLoading();
				try {
					const data = await Promise.all(names.map(load));
					const totals = data.map((d) => d.total_contributions);

					const cards = data.map((d, i) => {
						const card = el('div', '', 'card');
						const title = el('h2', names[i]);
						if (totals[i] > totals[1 - i]) {
							card.classList.add('winner');
							title.prepend(el('span', '', 'amber-bit'));
						}
						card.append(
							title,
							el('p', `Kontrybucje: ${totals[i]}`),
							el('p', `Zakres dat: ${d.from} – ${d.to}`),
							el('p', `Najdłuższa seria: ${longestStreak(d)} dni`),
							renderGraph(d, names[i]),
						);
						return card;
					});

					const verdict =
						totals[0] === totals[1]
							? 'Remis!'
							: `Wygrywa ${totals[0] > totals[1] ? names[0] : names[1]}! Bursztyn dla zwycięzcy`;

					results.replaceChildren(
						box('cards', cards[0], renderVsRig(), cards[1]),
						el('p', verdict, 'verdict'),
					);
				} catch (err) {
					showMessage(err instanceof Error ? err.message : 'Wystąpił błąd.', true);
				} finally {
					button.disabled = false;
				}
			});
		</script>
	</body>
</html>
