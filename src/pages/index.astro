---
import '../styles/arena.css';
import Skyline from '../components/Skyline.astro';
import Zuraw from '../components/Zuraw.astro';
import Monument from '../components/Monument.astro';
import Harbor from '../components/Harbor.astro';
import Crest from '../components/Crest.astro';
---

<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Press+Start+2P&display=swap"
		/>
		<title>Mayhem w Stoczni</title>
	</head>
	<body>
		<a class="skip-link" href="#results">Przejdź do wyników</a>
		<div class="sky" aria-hidden="true">
			<div class="stars"></div>
			<div class="sky-layer layer-far"><Skyline layer="far" /></div>
			<div class="sky-layer layer-near"><Skyline layer="near" /></div>
			<div class="sky-landmarks">
				<Monument />
				<Zuraw />
			</div>
			<Harbor />
		</div>

		<main>
			<div class="gate" aria-hidden="true">
				<span class="gate-pylon"></span>
				<span class="gate-sign">STOCZNIA GDAŃSKA<small>BRAMA NR 2</small></span>
				<span class="gate-pylon"></span>
			</div>

			<button type="button" id="mute" class="secondary mute">🔊 Wycisz dźwięk</button>

			<header class="title-wrap">
				<h1><Crest />Mayhem w Stoczni</h1>
				<p class="subtitle">Arena pojedynków na kontrybucje z GitHuba</p>
				<p class="place">Nabrzeże Motławy, noc</p>
			</header>

			<form id="duel-form" class="console" novalidate>
				<div class="field">
					<label for="player1">Gracz 1</label>
					<input id="player1" name="player1" autocomplete="off" required />
				</div>
				<div class="field">
					<label for="player2">Gracz 2</label>
					<input id="player2" name="player2" autocomplete="off" required />
				</div>
				<button type="submit">Walcz!</button>
			</form>

			<div class="stage">
				<div class="gantry-beam" aria-hidden="true">
					<span class="trolley"></span>
					<span class="beacon"></span>
				</div>
				<div class="gantry-leg left" aria-hidden="true"></div>
				<div class="gantry-leg right" aria-hidden="true"></div>
				<section id="results" aria-live="polite" aria-busy="false" tabindex="-1" aria-label="Wyniki pojedynku">
					<p class="status">Podaj dwóch graczy i naciśnij „Walcz!”</p>
				</section>
				<div class="quay" aria-hidden="true"></div>
			</div>

			<section class="history" aria-labelledby="history-title">
				<div class="history-head">
					<h2 id="history-title">Ostatnie pojedynki</h2>
					<button type="button" id="clear-history" class="secondary" hidden>Wyczyść historię</button>
				</div>
				<p id="history-empty" class="status">Brak pojedynków w dzienniku stoczni.</p>
				<ol id="history-list" class="history-list" hidden></ol>
			</section>
		</main>

		<script>
			import type { ContribsResponse } from '../lib/contributions';
			import { longestStreak } from '../lib/streak';
			import { isMuted, setMuted, playHorn, playBell, playExplosion } from '../lib/sound';

			const form = document.querySelector<HTMLFormElement>('#duel-form')!;
			const results = document.querySelector<HTMLElement>('#results')!;
			const button = form.querySelector('button')!;

			function el(tag: string, text: string, className?: string) {
				const node = document.createElement(tag);
				node.textContent = text;
				if (className) node.className = className;
				return node;
			}

			function box(className: string, ...children: Node[]) {
				const node = el('div', '', className);
				node.append(...children);
				return node;
			}

			const muteButton = document.querySelector<HTMLButtonElement>('#mute')!;
			function renderMute() {
				const muted = isMuted();
				muteButton.removeAttribute('aria-pressed');
				muteButton.textContent = muted ? '🔇 Włącz dźwięk' : '🔊 Wycisz dźwięk';
			}
			muteButton.addEventListener('click', () => {
				setMuted(!isMuted());
				renderMute();
			});
			renderMute();

			function showMessage(text: string, isError = false) {
				results.replaceChildren(el('p', text, isError ? 'error' : 'status'));
			}

			function showLoading() {
				const lift = box('loader-lift', el('span', '', 'rope'), el('span', '', 'hook'), el('span', '', 'loader-crate'));
				const loader = box('loader', box('loader-bay', lift), el('span', 'Ładowanie…'));
				loader.setAttribute('role', 'status');
				results.replaceChildren(loader);
			}

			function dayLabel(firstDay: string, weekday: number, count: number) {
				const date = new Date(`${firstDay}T00:00:00Z`);
				date.setUTCDate(date.getUTCDate() + weekday);
				return `${date.toISOString().slice(0, 10)}: ${count}`;
			}

			function renderGraph(data: ContribsResponse, name: string) {
				const graph = el('div', '', 'graph');
				graph.setAttribute('role', 'img');
				graph.setAttribute(
					'aria-label',
					`Kontrybucje użytkownika ${name}: ${data.total_contributions}, od ${data.from} do ${data.to}`,
				);
				data.weeks.forEach((week, col) => {
					for (const day of week.contribution_days) {
						const cell = el('span', '', 'day');
						cell.style.gridColumn = String(col + 1);
						cell.style.gridRow = String(day.weekday + 1);
						cell.dataset.level = String(Math.min(4, Math.max(0, day.level)));
						cell.title = dayLabel(week.first_day, day.weekday, day.count);
						graph.append(cell);
					}
				});
				const scroll = box('graph-scroll', graph);
				scroll.tabIndex = 0;
				scroll.setAttribute('role', 'region');
				scroll.setAttribute('aria-label', `Wykres kontrybucji użytkownika ${name} (przewijany)`);
				return scroll;
			}

			function renderLegend() {
				const items: Node[] = [el('span', 'Mniej', 'legend-label')];
				for (let level = 0; level <= 4; level++) {
					const swatch = el('span', '', 'day legend-box');
					swatch.dataset.level = String(level);
					items.push(swatch);
				}
				items.push(el('span', 'Więcej', 'legend-label'));
				const legend = box('legend', ...items);
				legend.setAttribute('aria-hidden', 'true');
				return legend;
			}

			function renderShare(names: string[], totals: number[]) {
				const winner = totals[0] === totals[1] ? null : names[totals[0] > totals[1] ? 0 : 1];
				const summary = [
					'⚓ Mayhem w Stoczni — wynik pojedynku',
					`${names[0]}: ${totals[0]} kontrybucji`,
					`${names[1]}: ${totals[1]} kontrybucji`,
					winner ? `🏆 Wygrywa: ${winner}` : '🤝 Remis!',
				].join('\n');
				const share = el('button', '📋 Udostępnij wynik', 'share');
				(share as HTMLButtonElement).type = 'button';
				const note = el('span', '', 'share-note');
				note.setAttribute('role', 'status');
				let timer: number | undefined;
				share.addEventListener('click', async () => {
					let ok = false;
					try {
						await navigator.clipboard.writeText(summary);
						ok = true;
					} catch {
						// brak uprawnień lub Clipboard API
					}
					note.textContent = ok ? 'Skopiowano!' : 'Nie udało się skopiować.';
					clearTimeout(timer);
					timer = window.setTimeout(() => (note.textContent = ''), 2000);
				});
				return box('share-wrap', share, note);
			}

			function renderVsRig() {
				const swing = box('vs-swing', el('span', '', 'rope'), el('span', '', 'hook'), el('div', 'VS', 'vs-box'));
				const carriage = box('vs-carriage', el('span', '', 'trolley'), swing);
				const rig = box('vs-rig', box('vs-girder'), box('vs-track', carriage));
				rig.setAttribute('aria-hidden', 'true');
				return rig;
			}

			const HISTORY_KEY = 'mayhem-history';
			const HISTORY_MAX = 10;
			interface DuelRecord {
				players: [string, string];
				totals: [number, number];
				winner: string | null;
				at: string;
			}

			function readHistory(): DuelRecord[] {
				try {
					const parsed = JSON.parse(localStorage.getItem(HISTORY_KEY) ?? '[]');
					if (!Array.isArray(parsed)) return [];
					return parsed
						.filter(
							(r): r is DuelRecord =>
								!!r &&
								Array.isArray(r.players) &&
								Array.isArray(r.totals) &&
								r.players.length === 2 &&
								r.totals.length === 2 &&
								typeof r.at === 'string',
						)
						.slice(0, HISTORY_MAX);
				} catch {
					return [];
				}
			}

			function writeHistory(list: DuelRecord[]) {
				try {
					localStorage.setItem(HISTORY_KEY, JSON.stringify(list));
				} catch {
					// brak dostępu do localStorage (np. tryb prywatny) — historia po prostu się nie zapisze
				}
			}

			const historyList = document.querySelector<HTMLOListElement>('#history-list')!;
			const historyEmpty = document.querySelector<HTMLElement>('#history-empty')!;
			const clearButton = document.querySelector<HTMLButtonElement>('#clear-history')!;

			function renderHistory() {
				const list = readHistory();
				historyList.hidden = list.length === 0;
				historyEmpty.hidden = list.length > 0;
				clearButton.hidden = list.length === 0;
				historyList.replaceChildren(
					...list.map((r) => {
						const when = new Date(r.at);
						const time = el('time', Number.isNaN(+when) ? '' : when.toLocaleString('pl-PL'), 'history-time');
						time.setAttribute('datetime', String(r.at));
						const li = el('li', '', 'history-item');
						li.append(
							el('span', `${r.players[0]} (${r.totals[0]}) vs ${r.players[1]} (${r.totals[1]})`, 'history-match'),
							el('span', r.winner ? `🏆 ${r.winner}` : '🤝 Remis', 'history-winner'),
							time,
						);
						return li;
					}),
				);
			}

			function saveDuel(names: string[], totals: number[]) {
				const record: DuelRecord = {
					players: [names[0], names[1]],
					totals: [totals[0], totals[1]],
					winner: totals[0] === totals[1] ? null : names[totals[0] > totals[1] ? 0 : 1],
					at: new Date().toISOString(),
				};
				writeHistory([record, ...readHistory()].slice(0, HISTORY_MAX));
				renderHistory();
			}

			clearButton.addEventListener('click', () => {
				try {
					localStorage.removeItem(HISTORY_KEY);
				} catch {
					// ignorujemy brak dostępu do localStorage
				}
				renderHistory();
			});
			renderHistory();

			function renderBanner(names: string[], totals: number[]) {
				const tie = totals[0] === totals[1];
				const text = tie ? '🤝 REMIS! 🤝' : `🏆 ${names[totals[0] > totals[1] ? 0 : 1]} WYGRYWA! 🏆`;
				const banner = box('verdict ' + (tie ? 'tie' : 'win'), el('span', text, 'verdict-text'));
				const confetti = box('confetti');
				confetti.setAttribute('aria-hidden', 'true');
				for (let i = 0; i < 24; i++) {
					const bit = el('span', '', 'confetti-bit');
					bit.style.setProperty('--x', `${(i * 37) % 100}%`);
					bit.style.setProperty('--d', `${((i * 53) % 20) / 10}s`);
					bit.style.setProperty('--t', `${2.4 + ((i * 7) % 10) / 10}s`);
					bit.dataset.level = String((i % 4) + 1);
					confetti.append(bit);
				}
				banner.append(confetti);
				return banner;
			}

			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const root = document.documentElement;
				addEventListener(
					'pointermove',
					(e) => root.style.setProperty('--px', String((e.clientX / innerWidth - 0.5) * 2)),
					{ passive: true },
				);
				let ticking = false;
				addEventListener(
					'scroll',
					() => {
						if (ticking) return;
						ticking = true;
						requestAnimationFrame(() => {
							root.style.setProperty('--sy', String(scrollY));
							ticking = false;
						});
					},
					{ passive: true },
				);
			}

			const USERNAME_RE = /^[a-z\d](?:[a-z\d]|-(?=[a-z\d])){0,38}$/i;
			const inputs = [
				form.elements.namedItem('player1') as HTMLInputElement,
				form.elements.namedItem('player2') as HTMLInputElement,
			];

			function clearFieldError(input: HTMLInputElement) {
				input.removeAttribute('aria-invalid');
				input.removeAttribute('aria-describedby');
				document.getElementById(`${input.id}-error`)?.remove();
			}

			function setFieldError(input: HTMLInputElement, text: string) {
				clearFieldError(input);
				const msg = el('p', text, 'field-error');
				msg.id = `${input.id}-error`;
				input.after(msg);
				input.setAttribute('aria-invalid', 'true');
				input.setAttribute('aria-describedby', msg.id);
			}

			function validate(names: string[]) {
				const errors: (string | null)[] = names.map((n) => {
					if (!n) return 'Podaj nazwę użytkownika GitHuba.';
					if (!USERNAME_RE.test(n))
						return 'Nazwa może mieć 1–39 znaków: litery, cyfry i pojedyncze myślniki (nie na początku ani końcu).';
					return null;
				});
				if (!errors[0] && !errors[1] && names[0].toLowerCase() === names[1].toLowerCase()) {
					errors[1] = 'Wybierz innego stoczniowca niż Gracz 1 — nie można walczyć z samym sobą.';
				}
				return errors;
			}

			for (const input of inputs) input.addEventListener('input', () => clearFieldError(input));

			async function load(name: string): Promise<ContribsResponse> {
				let res: Response;
				try {
					res = await fetch(`/api/contributions/${encodeURIComponent(name)}`);
				} catch {
					throw new Error(`Brak łączności z portem — nie udało się pobrać danych stoczniowca „${name}”. Sprawdź połączenie i spróbuj ponownie.`);
				}
				if (!res.ok) {
					const messages: Record<number, string> = {
						400: `Nazwa „${name}” jest niepoprawna — takiej nie wpiszemy do rejestru stoczni.`,
						404: `Nie znaleziono stoczniowca „${name}”. Sprawdź pisownię nazwy.`,
						429: `Za duży ruch w porcie — GitHub chwilowo ogranicza zapytania (stoczniowiec „${name}”). Odczekaj chwilę i spróbuj ponownie.`,
						502: `Brama GitHuba nie odpowiada poprawnie — nie udało się pobrać danych stoczniowca „${name}”. Spróbuj za chwilę.`,
						504: `Upłynął czas oczekiwania na dane stoczniowca „${name}”. Spróbuj ponownie.`,
					};
					throw new Error(messages[res.status] ?? `Nie udało się pobrać danych stoczniowca „${name}” (kod ${res.status}).`);
				}
				try {
					return await res.json();
				} catch {
					throw new Error(`Dane stoczniowca „${name}” dotarły uszkodzone (niepoprawny JSON). Spróbuj ponownie.`);
				}
			}

			function showLoadErrors(messages: string[]) {
				const wrap = el('div', '', 'error');
				wrap.setAttribute('role', 'alert');
				wrap.append(el('p', messages.length > 1 ? 'Awaria przy obu graczach:' : 'Awaria w stoczni:', 'error-title'));
				const list = el('ul', '', 'error-list');
				for (const m of messages) list.append(el('li', m));
				wrap.append(list);
				results.replaceChildren(wrap);
			}

			const COUNTDOWN_STEPS = ['3...', '2...', '1...', '⚡ WALCZ! ⚡'];
			const STEP_MS = 1000;

			function startCountdown() {
				if (matchMedia('(prefers-reduced-motion: reduce)').matches) return { done: Promise.resolve(), cancel() {} };
				const text = el('p', COUNTDOWN_STEPS[0], 'countdown-text');
				const overlay = box('countdown', text);
				overlay.setAttribute('aria-hidden', 'true');
				document.body.append(overlay);
				let cancelled = false;
				const done = (async () => {
					for (let i = 0; i < COUNTDOWN_STEPS.length; i++) {
						if (cancelled) return;
						// nowy węzeł restartuje animację kroku
						const step = el('p', COUNTDOWN_STEPS[i], i === COUNTDOWN_STEPS.length - 1 ? 'countdown-text go' : 'countdown-text');
						overlay.replaceChildren(step);
						await new Promise((r) => setTimeout(r, STEP_MS));
					}
				})().finally(() => overlay.remove());
				return {
					done,
					cancel() {
						cancelled = true;
						overlay.remove();
					},
				};
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const names = inputs.map((i) => i.value.trim());

				const errors = validate(names);
				inputs.forEach((input, i) => (errors[i] ? setFieldError(input, errors[i]!) : clearFieldError(input)));
				const firstInvalid = inputs.find((_, i) => errors[i]);
				if (firstInvalid) {
					showMessage('Popraw zaznaczone pola i spróbuj ponownie.');
					firstInvalid.focus();
					return;
				}

				playHorn();
				button.disabled = true;
				results.setAttribute('aria-busy', 'true');
				showLoading();
				const countdown = startCountdown();
				try {
					const settled = await Promise.allSettled(names.map(load));
					const failures = settled.flatMap((r) =>
						r.status === 'rejected' ? [r.reason instanceof Error ? r.reason.message : 'Wystąpił nieoczekiwany błąd.'] : [],
					);
					if (failures.length) {
						countdown.cancel();
						showLoadErrors(failures);
						playExplosion();
						return;
					}
					const data = settled.map((r) => (r as PromiseFulfilledResult<ContribsResponse>).value);
					const totals = data.map((d) => d.total_contributions);

					await countdown.done;
					try {
						saveDuel(names, totals);
					} catch {
						// historia nie może blokować wyników
					}
					playBell();

					const cards = data.map((d, i) => {
						const card = el('div', '', 'card');
						const title = el('h2', names[i]);
						if (totals[i] > totals[1 - i]) {
							card.classList.add('winner');
							title.prepend(el('span', '', 'amber-bit'));
						}
						card.append(
							title,
							el('p', `Kontrybucje: ${totals[i]}`),
							el('p', `Zakres dat: ${d.from} – ${d.to}`),
							renderGraph(d, names[i]),
							renderLegend(),
							el('p', `🔥 Najdłuższa seria: ${longestStreak(d)} dni`, 'streak'),
						);
						return card;
					});

					results.replaceChildren(
						box('cards reveal', cards[0], renderVsRig(), cards[1]),
						renderBanner(names, totals),
						renderShare(names, totals),
					);
				} catch (err) {
					countdown.cancel();
					showMessage(err instanceof Error ? err.message : 'Wystąpił błąd.', true);
					playExplosion();
				} finally {
					button.disabled = false;
					results.setAttribute('aria-busy', 'false');
					results.focus({ preventScroll: true });
				}
			});
		</script>
	</body>
</html>
